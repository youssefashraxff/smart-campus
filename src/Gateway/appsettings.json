{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth":          { "ClusterId": "auth",          "Match": { "Path": "/api/auth/{**rest}" } },
      "facilities":    { "ClusterId": "catalog",       "Match": { "Path": "/api/facilities/{**rest}" } },
      "events":        { "ClusterId": "catalog",       "Match": { "Path": "/api/events/{**rest}" } },
      "bookings":      { "ClusterId": "bookings",      "Match": { "Path": "/api/bookings/{**rest}" } },
      "registrations": { "ClusterId": "bookings",      "Match": { "Path": "/api/registrations/{**rest}" } },
      "notifications": { "ClusterId": "notifications", "Match": { "Path": "/api/notifications/{**rest}" } }
    },
    "Clusters": {
      "auth":          { "Destinations": { "d1": { "Address": "http://auth" } } },
      "catalog":       { "Destinations": { "d1": { "Address": "http://catalog" } } },
      "bookings":      { "Destinations": { "d1": { "Address": "http://bookings" } } },
      "notifications": { "Destinations": { "d1": { "Address": "http://notifications" } } }
    }
  }
}
