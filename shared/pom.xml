<?xml version="1.0" encoding="UTF-8"?>
<!-- Plain Java library (not a runnable app): contracts, service names and the error handler reused by the services -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.smartcampus</groupId>
        <artifactId>smart-campus</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>shared</artifactId>
    <name>Shared</name>

    <dependencies>
        <!-- ProblemDetail, @RestControllerAdvice and ResponseEntityExceptionHandler for the shared
             GlobalExceptionHandler. No version: set by the Spring Boot parent.
             optional = not passed on to modules that depend on shared. The services already have
             spring-boot-starter-webmvc; the gateway runs on WebFlux and must not get Spring MVC. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- @JsonIgnoreProperties / @JsonProperty on the contracts. Jackson 3 still uses these
             annotations (package com.fasterxml.jackson.annotation). No version: set by the root BOMs. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
    </dependencies>
</project>
