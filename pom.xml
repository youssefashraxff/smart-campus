<?xml version="1.0" encoding="UTF-8"?>
<!--
  Parent build file. It lists every module and sets the versions once, so each
  service's pom.xml only names the libraries it needs (no version numbers there).
  C# equivalent: SmartCampus.slnx + Directory.Build.props.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot's parent: picks compatible versions for every Spring library -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.smartcampus</groupId>
    <artifactId>smart-campus</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>Smart Campus</name>

    <modules>
        <module>shared</module>
        <module>gateway</module>
        <module>auth-service</module>
        <module>facility-catalog</module>
        <module>booking-engine</module>
        <module>notification-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- Spring Cloud release train that matches Spring Boot 4.1 (used by the gateway) -->
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.smartcampus</groupId>
                <artifactId>shared</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
