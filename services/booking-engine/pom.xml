<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.smartcampus</groupId>
        <artifactId>smart-campus</artifactId>
        <version>0.1.0</version>
        <!-- the root pom.xml is two folders up (services/<this-service>/) -->
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>booking-engine</artifactId>
    <name>Booking Engine</name>

    <dependencies>
        <!-- Web server + @RestController (C#: ASP.NET Core Web API) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- @Valid, @NotNull on request bodies (C#: DataAnnotations) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- @Entity + JpaRepository, Hibernate underneath (C#: EF Core) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Runs the SQL files in db/migration at startup (C#: EF Core migrations) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- PostgreSQL JDBC driver (C#: Npgsql) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Lombok: @Getter writes the getter methods at compile time (no version: set by Spring Boot) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.smartcampus</groupId>
            <artifactId>shared</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Adds "mvn spring-boot:run" and builds a runnable .jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
