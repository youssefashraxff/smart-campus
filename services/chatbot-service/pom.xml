<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.smartcampus</groupId>
        <artifactId>smart-campus</artifactId>
        <version>0.1.0</version>
        <!-- the root pom.xml is two folders up (services/<this-service>/) -->
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>chatbot-service</artifactId>
    <name>Chatbot Service</name>

    <!-- No JPA, no Flyway, no PostgreSQL driver: this service owns no tables. It only talks to the
         LLM (Groq) and reads from the catalog and booking services over HTTP (FR-B3). -->
    <dependencies>
        <!-- Web server + @RestController + RestClient -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- @Valid, @NotBlank, @Size on the chat request -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- FacilityResponse, EventResponse, TimeSlot, exceptions and GlobalExceptionHandler -->
        <dependency>
            <groupId>com.smartcampus</groupId>
            <artifactId>shared</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
