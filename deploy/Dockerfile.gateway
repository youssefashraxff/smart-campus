# Render build for gateway (see render.yaml). Build context = repository root.
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY . .
RUN mvn -B -q -DskipTests -pl gateway -am package && cp gateway/target/*.jar /app.jar

FROM eclipse-temurin:21-jre
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app.jar /app/app.jar
COPY deploy/start.sh /app/start.sh
COPY db/seed.sql /app/seed.sql
# Free Render instances have 512 MB RAM: cap the heap and favour fast startup over peak speed
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70 -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xss512k"
CMD ["/app/start.sh"]
